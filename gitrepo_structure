### 14. `Dockerfile`

```dockerfile
# OSINT Ultimate Suite - Container for testing
# NOT for production use - users should run installer locally

FROM kalilinux/kali-rolling

LABEL maintainer="Your Name <your@email.com>"
LABEL description="OSINT Ultimate Suite - Testing container"
LABEL version="3.0.0"
LABEL license="MIT"

ARG DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip python3-venv git curl wget \
    build-essential golang-go \
    nmap whois dnsutils hydra exiftool \
    geoip-bin netdiscover sslscan tor \
    libssl-dev libffi-dev libxml2-dev libxslt1-dev \
    zlib1g-dev ripgrep jq openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /osint

# Copy scripts
COPY scripts/ /osint/scripts/
COPY docs/ /osint/docs/

# Make scripts executable
RUN chmod +x /osint/scripts/*.sh

# Environment
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/go/binPATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/go/bin"
ENV OSINT_HOME=/osint

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD test -d /osint || exit 1

# Default command
CMD ["/bin/bash"]
```

